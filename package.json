{
  "name": "edu-agent",
  "version": "6.0.0",
  "description": "Edu — an installable, LLM-agnostic agentic harness: a self-improving second brain, an orchestrator with identity, and a live terminal view of your agents.",
  "type": "module",
  "bin": {
    "edu": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "templates",
    "!templates/**/*.test.ts",
    "!templates/**/*.test.tsx",
    "plugins",
    ".claude-plugin",
    ".agents/plugins",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --project contracts",
    "test:perf": "vitest run --project perf",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=60000 --project unit --project contracts",
    "build:plugins": "node --experimental-strip-types scripts/build-plugins.ts",
    "test:watch": "vitest --project unit --project contracts",
    "test:deck": "node --experimental-strip-types scripts/test-claude-mod.mjs",
    "check": "npm run typecheck && npm run lint && npm test -- --maxWorkers=2 && npm run build",
    "prepack": "npm run build",
    "smoke": "bash scripts/smoke-install.sh",
    "check:dist": "npm run build && node scripts/check-dist.mjs"
  },
  "keywords": [
    "agents",
    "llm",
    "claude-code",
    "codex",
    "pi",
    "opencode",
    "harness",
    "second-brain",
    "mcp",
    "obsidian",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./plugins/pi/extensions"
    ],
    "prompts": [
      "./plugins/pi/prompts"
    ],
    "themes": [
      "./plugins/pi/themes"
    ]
  },
  "author": "Eduardo Moraga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoMoraga/edu.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.1",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.15.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.3"
  }
}
